# Copy to .env.local for local work, or add each variable in the Vercel project settings.
# Never commit real values. With none of these set, the API runs in mock mode:
# emails are written to .local/outbox/, uploads to .local/uploads/ (see README, "Quote form backend").

# Email. Leave RESEND_API_KEY empty to keep using the local outbox.
# Resend API key with "Sending access" only (https://resend.com/api-keys).
RESEND_API_KEY=
# Sender address. In Resend test mode use onboarding@resend.dev; later an address on your own verified domain.
MAIL_FROM=onboarding@resend.dev
# Where the shop's copy of each request goes (the shop's real inbox).
MAIL_TO_SHOP=
# Test mode: when set, EVERY email is redirected to this address and the subject gets a
# "[TEST -> original address]" prefix. In Resend test mode this must be the Resend account owner's address.
# Remove it when a domain is verified and real mail should go out.
MAIL_TEST_RECIPIENT=

# File storage. Leave empty to keep using .local/uploads/.
# Read-write token of a PRIVATE Vercel Blob store. Vercel adds it when you connect the store to the project.
BLOB_READ_WRITE_TOKEN=

# Safety switch: on Vercel the API refuses to run in mock mode (it would swallow real requests).
# Set to 1 only for a throwaway preview deployment where losing requests does not matter.
ALLOW_MOCKS=

# Local API server port for `npm run dev:api` (default 8787).
API_PORT=
