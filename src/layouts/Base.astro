---
// Every page uses this layout: <head> (SEO, fonts, CSP-friendly assets), demo strip, header, footer.
import '@fontsource-variable/archivo/wdth.css';
import '@fontsource/ibm-plex-mono/latin-400.css';
import '@fontsource/ibm-plex-mono/latin-500.css';
import '../styles/tokens.css';
import '../styles/base.css';
import '../styles/layout.css';
import '../styles/print.css';
import archivoLatin from '@fontsource-variable/archivo/files/archivo-latin-wdth-normal.woff2?url';
import DemoBanner from '../components/DemoBanner.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site } from '../config/site';
import { cleanPath } from '../lib/paths';

interface Props {
  title: string;
  description?: string;
  /** Structured data object(s) for this page; serialized as JSON-LD. */
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
}

const { title, description = site.description, jsonLd } = Astro.props;
const fullTitle = title === site.name ? `${site.name}: ${site.tagline}` : `${title} | ${site.name}`;
const canonical = new URL(cleanPath(Astro.url.pathname), Astro.site);
const ogImage = new URL('/og.png', Astro.site);
---

<!doctype html>
<html lang="en-US" data-unit={site.defaultUnit}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {site.noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preload" href={archivoLatin} as="font" type="font/woff2" crossorigin />
    <meta name="theme-color" content="#f3f5f4" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />

    <script is:inline src="/boot.js"></script>
    {/* "<" is escaped so a string in the data can never close the script tag. */}
    {jsonLd && (
      <script
        type="application/ld+json"
        set:html={JSON.stringify(jsonLd).replace(/</g, '\\u003c')}
      />
    )}
  </head>
  <body>
    <a class="skip-link" href="#main">
      Skip to content
    </a>
    {site.demo && <DemoBanner />}
    <Header />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer />
  </body>
</html>

<style is:global>
  .skip-link {
    position: absolute;
    inset-inline-start: var(--space-4);
    inset-block-start: -10rem;
    z-index: 10;
    padding: var(--space-3) var(--space-4);
    background: var(--ink);
    color: var(--white);
  }
  .skip-link:focus {
    inset-block-start: var(--space-4);
  }
  main:focus {
    outline: none;
  }
</style>
