---
// Source for public/og.png (1200 × 630 social preview). Not linked from the site and kept out
// of the sitemap. Regenerate after design changes: see README, "Social preview image".
import '@fontsource-variable/archivo/wdth.css';
import '@fontsource/ibm-plex-mono/latin-400.css';
import '../styles/tokens.css';
import '../styles/base.css';
import '../styles/layout.css';
import HousingDrawing from '../components/drawings/HousingDrawing.astro';
import { site } from '../config/site';
---

<!doctype html>
<html lang="en-US" data-unit="in">
  <head>
    <meta charset="utf-8" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Social preview</title>
  </head>
  <body>
    <div class="card">
      <div class="text">
        <p class="name">{site.name}</p>
        <p class="headline">Built to print. Held to ±0.0005 in.</p>
        <p class="sub">Contract CNC machining, Pennsylvania. Portfolio demo.</p>
      </div>
      <div class="dwg-box grid-paper">
        <HousingDrawing id="og" crop="plan" />
      </div>
    </div>
  </body>
</html>

<style>
  body {
    margin: 0;
  }
  .card {
    inline-size: 1200px;
    block-size: 630px;
    display: grid;
    grid-template-columns: 500px 1fr;
    border: 12px solid var(--ink);
    background: var(--white);
  }
  .text {
    display: grid;
    align-content: center;
    gap: 24px;
    padding: 48px;
    border-inline-end: 1px solid var(--ink);
  }
  .name {
    font-weight: 700;
    font-stretch: 112%;
    font-size: 26px;
  }
  .headline {
    font-size: 60px;
    line-height: 1.02;
    font-weight: 640;
    font-stretch: 112%;
    letter-spacing: -0.02em;
  }
  .sub {
    font-size: 22px;
    color: var(--steel);
  }
  .dwg-box {
    display: grid;
    place-items: center;
    padding: 24px;
  }
</style>
