---
// Top of an inner page: title, one-paragraph intro, optional breadcrumb back to a parent.
interface Props {
  title: string;
  intro?: string;
  parent?: { href: string; label: string };
}
const { title, intro, parent } = Astro.props;
---

<header class="page-header container">
  {parent && (
    <nav aria-label="Breadcrumb">
      <a href={parent.href}>{parent.label}</a>
    </nav>
  )}
  <h1>{title}</h1>
  {intro && <p class="intro">{intro}</p>}
  <slot />
</header>

<style>
  .page-header {
    display: grid;
    gap: var(--space-4);
    padding-block: var(--space-7) var(--space-6);
  }
  h1 {
    font-size: clamp(2.2rem, 1.5rem + 2.6vw, 3.6rem);
    max-inline-size: 20ch;
  }
  .intro {
    font-size: var(--step-1);
    color: var(--steel);
    max-inline-size: 52ch;
  }
  nav a {
    display: inline-flex;
    align-items: center;
    min-block-size: var(--tap);
    font-weight: 500;
  }
</style>
