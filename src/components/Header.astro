---
import Logo from './Logo.astro';
import Button from './Button.astro';
import UnitToggle from './UnitToggle.astro';
import { nav } from '../config/site';
import { cleanPath } from '../lib/paths';

const path = cleanPath(Astro.url.pathname);
const isCurrent = (href: string) => path === href || path.startsWith(`${href}/`);
---

<header class="header">
  <div class="container header-inner">
    <Logo />
    <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="site-nav">
      Menu
    </button>
    <nav id="site-nav" class="nav" aria-label="Main">
      <ul>
        {nav.map((item) => (
          <li>
            <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>
              {item.label}
            </a>
          </li>
        ))}
      </ul>
      <div class="nav-tools">
        <UnitToggle />
        <Button href="/rfq">Request a quote</Button>
      </div>
    </nav>
  </div>
</header>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('.menu-toggle');
  const nav = document.querySelector<HTMLElement>('#site-nav');
  toggle?.addEventListener('click', () => {
    const open = toggle.getAttribute('aria-expanded') !== 'true';
    toggle.setAttribute('aria-expanded', String(open));
    nav?.toggleAttribute('data-open', open);
  });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && toggle?.getAttribute('aria-expanded') === 'true') {
      toggle.click();
      toggle.focus();
    }
  });
</script>

<style>
  .header {
    border-block-end: 1px solid var(--line);
    background: var(--paper);
  }
  .header-inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3) var(--space-5);
    padding-block: var(--space-3);
  }
  .nav {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-3) var(--space-5);
  }
  .nav ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0 var(--space-5);
    padding: 0;
    list-style: none;
  }
  .nav a:not(.btn) {
    display: inline-flex;
    align-items: center;
    min-block-size: var(--tap);
    color: var(--ink);
    text-decoration: none;
    font-weight: 500;
  }
  .nav a:not(.btn):hover {
    color: var(--blue);
  }
  .nav a[aria-current='page'] {
    color: var(--blue);
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 0.5em;
  }
  .nav-tools {
    display: flex;
    align-items: center;
    gap: var(--space-4);
  }
  .menu-toggle {
    display: none;
    min-block-size: var(--tap);
    padding-inline: var(--space-4);
    background: transparent;
    border: 1px solid var(--line-strong);
    border-radius: var(--radius);
    font-weight: 600;
    cursor: pointer;
  }

  /* Small screens: with JS the nav collapses behind "Menu"; without JS it simply wraps. */
  @media (max-width: 63.99rem) {
    :global(.js) .menu-toggle {
      display: inline-flex;
      align-items: center;
    }
    :global(.js) .nav {
      display: none;
    }
    :global(.js) .nav[data-open] {
      display: grid;
      inline-size: 100%;
      gap: var(--space-4);
      padding-block: var(--space-3) var(--space-4);
    }
    .nav ul {
      display: grid;
      inline-size: 100%;
    }
    .nav li + li {
      border-block-start: 1px solid var(--line);
    }
    .nav-tools {
      justify-content: space-between;
    }
  }
</style>
