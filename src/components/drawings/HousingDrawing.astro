---
// Sensor housing (the part from the 7075 case study): front view and section A–A.
// Scale: 80 user units = 1 in. Part 4.200 × 2.800 × 1.600 in, front view origin (80, 70).
// crop="front": front view only, readable on a phone. crop="plan": front view with callouts.
import './drawing.css';
import DwgDefs from './DwgDefs.astro';
import DwgValue from './DwgValue.astro';

interface Props {
  id: string;
  crop?: 'full' | 'front' | 'plan';
  /** Fade dimensions in once on load (hero only). */
  animate?: boolean;
  class?: string;
}
const { id, crop = 'full', animate = false, class: cls } = Astro.props;
const full = crop === 'full';
const callouts = crop !== 'front';
const viewBox = { full: '0 0 700 580', front: '0 26 462 318', plan: '0 26 650 318' }[crop];
const arrow = `url(#${id}-arrow)`;
const arrowBlue = `url(#${id}-arrow-blue)`;
const hatch = `url(#${id}-hatch)`;

const holes = [
  [108, 98],
  [388, 98],
  [108, 266],
  [388, 266],
] as const;
---

<svg
  class:list={['dwg', { 'dwg-animate': animate }, cls]}
  viewBox={viewBox}
  role="img"
  aria-labelledby={`${id}-title`}
>
  <title id={`${id}-title`}>
    Engineering drawing of an aluminum sensor housing, 4.200 by 2.800 by 1.600 inches, with a 1.2500
    inch bore held to plus or minus 0.0005 inch and positioned within 0.0005 inch of datum A.
  </title>
  <DwgDefs id={id} />

  <!-- Front view -->
  <g>
    <rect class="obj" x="80" y="70" width="336" height="224"></rect>
    <circle class="obj" cx="248" cy="182" r="60"></circle>
    <circle class="obj" cx="248" cy="182" r="50"></circle>
    {holes.map(([x, y]) => (
      <circle class="obj" cx={x} cy={y} r="8" />
    ))}
    <path class="ctr" d="M60 182H436M248 50V304"></path>
    {holes.map(([x, y]) => (
      <path class="ctr" d={`M${x - 16} ${y}H${x + 16}M${x} ${y - 16}V${y + 16}`} />
    ))}
    <!-- Cutting plane A–A, ends only -->
    <path class="cut" d="M44 182H70M426 182H452"></path>
    <path class="dim" d="M54 182V206M444 182V206" marker-end={arrow}></path>
    <text class="dwg-t label" x="54" y="172" text-anchor="middle">
      A
    </text>
    <text class="dwg-t label" x="444" y="172" text-anchor="middle">
      A
    </text>
  </g>

  <!-- Front view dimensions -->
  <g class="dwg-reveal r1">
    <path class="dim" d="M80 300V336M416 300V336"></path>
    <path class="dim" d="M80 326H416" marker-start={arrow} marker-end={arrow}></path>
    <DwgValue x={248} y={320} value="4.200" />
    <path class="dim" d="M74 70H18M74 294H18"></path>
    <path class="dim" d="M26 70V294" marker-start={arrow} marker-end={arrow}></path>
    <DwgValue x={20} y={182} value="2.800" rotate={-90} />
    <path class="dim" d="M108 86V38M388 86V38"></path>
    <path class="dim" d="M108 46H388" marker-start={arrow} marker-end={arrow}></path>
    <DwgValue x={248} y={40} value="3.500" />
  </g>

  {callouts && (
    <>
      <g class="dwg-reveal r2">
        <path class="dim" d="M394 272 452 304H476" marker-start={arrow} />
        <DwgValue x={480} y={309} value="0.201" before="4× Ø" after=" THRU" anchor="start" />
        <path class="dim" d="M304.4 161.5 456 162H476" marker-start={arrow} />
        <DwgValue x={480} y={167} value="1.500" before="CBORE Ø" anchor="start" />
        <DwgValue x={480} y={187} value="0.250" before="DEPTH " anchor="start" class="small" />
      </g>

      <!-- The callout the page is about: bore size and position -->
      <g class="dwg-reveal r3">
        <path class="blue" d="M283.4 146.6 456 96H476" marker-start={arrowBlue} />
        <DwgValue
          x={480}
          y={101}
          value="1.2500"
          before="Ø"
          tol="0.0005"
          anchor="start"
          class="blue"
        />
        <rect class="blue" x="480" y="112" width="152" height="28" />
        <path class="blue" d="M510 112V140M604 112V140" />
        <circle class="blue" cx="495" cy="126" r="6" />
        <path class="blue" d="M486 126H504M495 117V135" />
        <DwgValue x={557} y={131} value="0.0005" before="Ø" class="blue" />
        <text class="dwg-t blue" x="618" y="131" text-anchor="middle">
          A
        </text>
      </g>
    </>
  )}

  {full && (
    <>
      <!-- Section A–A, projected below the front view -->
      <g>
        <path class="obj" fill={hatch} d="M80 390H188V410H198V518H176V438H108V518H80Z" />
        <path class="obj" fill={hatch} d="M416 390H308V410H298V518H320V438H388V518H416Z" />
        <path class="obj" d="M188 390H308M198 518H298" />
        <path class="ctr" d="M248 376V532" />
        <text class="dwg-t label" x="248" y="566" text-anchor="middle">
          SECTION A–A
        </text>
      </g>

      <g class="dwg-reveal r4">
        <path class="dim" d="M422 390H458M422 518H458" />
        <path class="dim" d="M450 390V518" marker-start={arrow} marker-end={arrow} />
        <DwgValue x={470} y={454} value="1.600" rotate={-90} />
        <!-- Datum A on the mounting face -->
        <path class="dim" d="M74 518H20" />
        <path class="fill-blue" d="M28 518H40L34 528Z" />
        <path class="blue" d="M34 528V536" />
        <rect class="blue" x="22" y="536" width="24" height="24" />
        <text class="dwg-t blue" x="34" y="553" text-anchor="middle">
          A
        </text>
      </g>
    </>
  )}
</svg>

<style>
  .dwg {
    inline-size: 100%;
    block-size: auto;
  }
  /* the load animation (.dwg-animate) lives in drawing.css */
</style>
