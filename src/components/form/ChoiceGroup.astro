---
// A fieldset of checkboxes or radios with a legend.
interface Props {
  name: string;
  legend: string;
  type?: 'checkbox' | 'radio';
  options: readonly { value: string; label: string; checked?: boolean }[];
  hint?: string;
}
const { name, legend, type = 'checkbox', options, hint } = Astro.props;
---

<fieldset class="choices">
  <legend>
    {legend} {type === 'checkbox' && <span class="optional">(optional)</span>}
  </legend>
  {hint && <p class="hint">{hint}</p>}
  <div class="grid">
    {options.map((o) => (
      <label>
        <input type={type} name={name} value={o.value} checked={o.checked} />
        <span>{o.label}</span>
      </label>
    ))}
  </div>
</fieldset>

<style>
  .choices {
    display: grid;
    gap: var(--space-2);
    margin: 0;
    padding: 0;
    border: 0;
    min-inline-size: 0;
  }
  legend {
    padding: 0;
    font-weight: 600;
    margin-block-end: var(--space-2);
  }
  .optional,
  .hint {
    color: var(--steel);
    font-weight: 400;
  }
  .hint {
    font-size: var(--step--1);
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(12rem, 1fr));
    gap: 0 var(--space-4);
  }
  label {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    min-block-size: var(--tap);
    cursor: pointer;
  }
  input {
    flex: none;
    inline-size: 1.25rem;
    block-size: 1.25rem;
    margin: 0;
    accent-color: var(--blue);
  }
</style>
