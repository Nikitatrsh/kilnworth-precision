---
// RFQ step 1: what the part is. A drawing OR a description is required (rfq.ts checks that).
import Field from '../form/Field.astro';
import Button from '../Button.astro';
import { ACCEPT_ATTR } from '../../lib/rfq-validate';
import { MATERIAL_OPTIONS, PROCESS_OPTIONS, formAttrs } from '../../lib/rfq-rules';

// Option lists live in src/lib/rfq-rules.ts, the same table the server checks against.
const processOptions = [{ value: '', label: 'Choose a process' }, ...PROCESS_OPTIONS];
const materialOptions = [{ value: '', label: 'Choose a material' }, ...MATERIAL_OPTIONS];
---

<fieldset class="step" data-step="0">
  <legend>
    <span class="step-of">Step 1 of 3</span> The part
  </legend>
  <Field name="part" {...formAttrs('part')} autocomplete="off" />
  <Field
    name="files"
    label="Drawings and models"
    kind="file"
    multiple
    accept={ACCEPT_ATTR}
    hint="STEP, IGES, DWG, DXF or PDF. Up to 5 files, 25 MB each. A PDF print with tolerances gets you a firmer price."
  />
  <ul class="file-list" data-file-list aria-live="polite"></ul>
  <Field
    name="description"
    {...formAttrs('description')}
    optionalLabel="(required if no file)"
    kind="textarea"
    hint="No drawing yet? Rough size, material, and the features and tolerances that matter are enough for a budget price."
  />
  <div class="two">
    <Field name="process" {...formAttrs('process')} kind="select" options={processOptions} />
    <Field name="material" {...formAttrs('material')} kind="select" options={materialOptions} />
  </div>
  <div class="two">
    <Field name="quantity" {...formAttrs('quantity')} kind="number" step="1" inputmode="numeric" />
    <Field name="breaks" {...formAttrs('breaks')} hint="For example: 50, 250, 1000" />
  </div>
  <div class="nav">
    <Button type="button" data-next>
      Continue to details
    </Button>
  </div>
</fieldset>
