---
// RFQ step 3: who gets the quote. Includes the honeypot field `website` (bots fill it), the
// live status while files upload and the request is sent, and the box for errors of the whole form.
import { site } from '../../config/site';
import Field from '../form/Field.astro';
import Button from '../Button.astro';
import { HONEYPOT_FIELD, formAttrs } from '../../lib/rfq-rules';
---

<fieldset class="step" data-step="2">
  <legend>
    <span class="step-of">Step 3 of 3</span> Where to send the quote
  </legend>
  <div class="two">
    <Field name="name" {...formAttrs('name')} autocomplete="name" />
    <Field name="company" {...formAttrs('company')} autocomplete="organization" />
  </div>
  <div class="two">
    <Field name="email" {...formAttrs('email')} kind="email" autocomplete="email" />
    <Field name="phone" {...formAttrs('phone')} kind="tel" autocomplete="tel" />
  </div>
  <div class="hp" aria-hidden="true">
    <label for="f-website">Leave this field empty</label>
    <input id="f-website" name={HONEYPOT_FIELD} type="text" tabindex="-1" autocomplete="off" />
  </div>
  <p class="fine">
    We use these details only to answer this request. <a href="/privacy">Privacy</a>
  </p>
  <div class="send-error" data-send-error role="alert" tabindex="-1" hidden></div>
  <div class="send-status">
    <!-- Always rendered (only empty), so screen readers already watch it when the text changes. -->
    <p role="status" data-status-text></p>
    <progress data-progress max="1" value="0" hidden>
      Uploading
    </progress>
  </div>
  <div class="nav">
    <Button type="button" variant="secondary" data-back>
      Back to requirements
    </Button>
    <Button type="submit" disabled data-submit>
      Send request for quote
    </Button>
  </div>
  <noscript>
    <p class="fine">
      Sending this form needs JavaScript (drawings upload through it). Without it, email your
      drawing to <a href={`mailto:${site.email}`}>{site.email}</a> or call{' '}
      <a href={site.phone.href}>{site.phone.display}</a>.
    </p>
  </noscript>
</fieldset>
