---
// RFQ step 2: tolerance, finishing, paperwork, date, notes.
import Field from '../form/Field.astro';
import ChoiceGroup from '../form/ChoiceGroup.astro';
import Button from '../Button.astro';
import {
  DOCS_OPTIONS,
  FIELDS,
  FINISHING_OPTIONS,
  TOLERANCE_OPTIONS,
  formAttrs,
} from '../../lib/rfq-rules';
---

<fieldset class="step" data-step="1">
  <legend>
    <span class="step-of">Step 2 of 3</span> Requirements
  </legend>
  <Field name="tolerance" {...formAttrs('tolerance')} kind="select" options={TOLERANCE_OPTIONS} />
  <ChoiceGroup name="finishing" legend={FIELDS.finishing.label} options={FINISHING_OPTIONS} />
  <ChoiceGroup name="docs" legend={FIELDS.docs.label} options={DOCS_OPTIONS} />
  <Field
    name="date"
    {...formAttrs('date')}
    kind="date"
    hint="Leave empty if you just want a lead time."
  />
  <Field
    name="notes"
    {...formAttrs('notes')}
    kind="textarea"
    hint="Critical features, how the part is used, anything the drawing does not say."
  />
  <div class="nav">
    <Button type="button" variant="secondary" data-back>
      Back to the part
    </Button>
    <Button type="button" data-next>
      Continue to contact
    </Button>
  </div>
</fieldset>
