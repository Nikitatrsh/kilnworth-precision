---
// Who we machine for, with the parts and paperwork each industry actually asks for.
const industries = [
  {
    name: 'Medical devices',
    parts: 'Bone screws, instrument handles, implant trial components, fluidic manifolds.',
    detail:
      'Titanium, 316L and PEEK. Lot traceability for the device history record; passivation through a validated partner.',
  },
  {
    name: 'Aerospace and defense',
    parts: 'Sensor housings, brackets, fittings, connector bodies.',
    detail:
      '7075, 17-4 PH and Inconel 718. AS9102 first articles, flow-down requirements read before we quote.',
  },
  {
    name: 'Industrial automation',
    parts: 'Valve manifolds, gripper fingers, fixture plates, shafts.',
    detail:
      'Quick-turn prototypes and repeat lots on blanket orders, with stock held for scheduled releases.',
  },
];
---

<div class="industries">
  {industries.map((i) => (
    <section>
      <h3>{i.name}</h3>
      <p class="parts">{i.parts}</p>
      <p class="detail">{i.detail}</p>
    </section>
  ))}
</div>

<style>
  .industries {
    display: grid;
    gap: 0 var(--gutter);
    border-block-start: 2px solid var(--ink);
  }
  @media (min-width: 52rem) {
    .industries {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
  section {
    display: grid;
    align-content: start;
    gap: var(--space-2);
    padding-block: var(--space-4) var(--space-5);
    border-block-end: 1px solid var(--line);
  }
  h3 {
    font-size: var(--step-1);
  }
  .parts {
    font-weight: 500;
  }
  .detail {
    color: var(--steel);
  }
</style>
