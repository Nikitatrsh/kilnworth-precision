{
  "name": "kilnworth-precision",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Portfolio demo: website for a fictional contract CNC machine shop.",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "dev:api": "node scripts/dev-api.mjs",
    "smoke:rfq": "node scripts/rfq-smoke.mjs",
    "preview": "astro preview",
    "check": "astro check",
    "test": "vitest run",
    "check-links": "node scripts/check-links.mjs",
    "shoot": "node scripts/shoot.mjs",
    "format": "prettier --write .",
    "verify": "npm run build && npm test && npm run check && npm run check-links"
  },
  "dependencies": {
    "@fontsource-variable/archivo": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@vercel/blob": "^2.8.2",
    "astro": "^7.4.5"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@astrojs/sitemap": "^3.7.4",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.2",
    "typescript": "^6.0.3",
    "vitest": "^4.1.12"
  },
  "overrides": {
    "@vercel/cli-config": "0.3.6"
  }
}
